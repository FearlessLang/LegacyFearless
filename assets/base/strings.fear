package base
Str: Sealed,Stringable,base.flows.Joinable[Str],ToHash{
  read .isEmpty: Bool,
  /// The number of Unicode codepoints in the string.
  .size: Nat,
  +(other: read Stringable): Str,
  ==(other: Str): Bool,
  !=(other: Str): Bool,
  .startsWith(other: Str): Bool,
  .assertEq(other: Str): Void,
  .assertEq(message: Str, other: Str): Void,
  /// Codepoint-indexed substring. Will throw when an out of bounds index is requested.
  .substring(start: Nat, end: Nat): Str,
  /// Codepoint-indexed access, returning a one-codepoint Str.
  .charAt(index: Nat): Str,
  /// Normalise using NFC. See https://www.unicode.org/reports/tr15/ for more information.
  .normalise: Str,
  mut .append(other: read Stringable): Void,
  mut +(other: read Stringable): mut Str,
  mut .clear: Void,
  /// A flow over the Unicode codepoints of this string, each as a one-codepoint Str.
  .codepoints: mut Flow[Str],
  /// A flow over the extended grapheme clusters of this string, each as a Str.
  /// The groupings of codepoints into clusters is Unicode-version-dependent and cannot be relied upon to
  /// be consistent across versions of the Unicode standard.
  .graphemes: mut Flow[Str],

  // Conversions
  .float: mut Action[Float],
  .utf8: List[Byte],
  }

Stringable: {
  read .str: Str,
  }

UTF16: RuntimeImplemented{
  .fromCodePoint(codePoint: Nat): Str -> Magic!,
  .isSurrogate(codePoint: Nat): Bool -> codePoint >= 55296 & (codePoint < 57344),
  .fromSurrogatePair(high: Nat, low: Nat): Str -> Magic!,
  }

UTF8: RuntimeImplemented{
  .fromBytes(utf8Bytes: read List[Byte]): mut Action[Str] -> Magic!,
  }

SimpleStr: Str{}

StrMap[V:*]: LinkedLens[Str, V]{k1, k2 -> k1 == k2}

_StrInstance: RuntimeImplemented,Str{
  .size -> Magic!,
  .isEmpty -> Magic!,
  +(other) -> Magic!,
  ==(other) -> Magic!,
  !=(other) -> Magic!,
  .startsWith(other) -> Magic!,
  .assertEq(other) -> Magic!,
  .assertEq(other, message) -> Magic!,
  .str -> Magic!,
  .substring(_,_) -> Magic!,
  .charAt(_) -> Magic!,
  .normalise -> Magic!,
  .append(_) -> Magic!,
  .clear -> Magic!,
  .codepoints -> Magic!,
  .graphemes -> Magic!,
  .join(_) -> Magic!,
  .hash(h) -> Magic!,
  .float -> Magic!,
  .utf8 -> Magic!,
  }

_StrHelpers: {
  .assertEq(expected: Str, actual: Str): Void ->
    Assert!(expected == actual, "Expected: "+expected+"\nActual: "+actual, {{}}),
  .assertEq(expected: Str, actual: Str, message: Str): Void ->
    Assert!(expected == actual, message+"\nExpected: "+expected+"\nActual: "+actual, {{}}),
  }
