package base.flows

/// This private & sealed type is for interoperability with the FeaRT runtime for Fearless.
/// With FeaRT, flows are implemented magically in the Fearless runtime for performance reasons and
/// to enable automatic parallelisation. We use VPF to implement the automatic parallelisation, unlike the
/// Java backend where we had custom strategies distinct from VPF. The way it works is that we rely on the
/// `.merge/3` method being called as a VPF method call so our `.driveReduce`, `.driveCollect`, etc. methods
/// can be VPF parallelised. We have a special case in Mearless to allow VPF to trigger for `.merge/3` despite
/// the fact that the method call could introduce user observable effects if not handled correctly.
///
/// The FeaRT code that implements this type is in `runtime/flows/driver.zig` and delegates to the generated
/// Fearless code written here except for the magic methods.
/// Magic methods that depend on runtime state are still marked as `mut` to abide by the Fearless type system's rules.
_FeartDriver: Sealed{
  /// This method is functionally the same as the `.fold` method on the public API allowing for arbitrary
  /// folding of a split flow.
  mut .driveReduce[E:*,A:*](flow: mut Flow[E], initial: A, combine: read F[A,E,A]): A ->
    this.driveReduceFn[E,A](flow, initial, read _FeartReduceFn[A,E]{a, e -> combine#(a, e)}),

  mut .driveReduceFn[E:*,A:*](flow: mut Flow[E], initial: A, combine: read _FeartReduceFn[A,E]): A -> _FeartDriver.splitMatch[E,A](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> initial,
      .else -> _FeartDriver.merge[E,A](
        this.driveReduceFn[E,A](left, initial, combine),
        this.driveReduceFn[E,A](right, initial, combine),
        combine
        ),
      },
    .empty -> this.runChunkReduce[E,A](flow, initial, combine),
    }),

  /// This method is a bit smarter than `.driveReduce` because we know the implementation of the list
  /// data structure and can make optimisations that would not be safe with an arbitrary user-defined folding function.
  mut .driveCollect[E:*](flow: mut Flow[E]): mut List[E] -> _FeartDriver.splitMatch[E, mut List[E]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> List#[E],
      .else -> _FeartDriver.merge[mut List[E], mut List[E]](
        this.driveCollect[E](left),
        this.driveCollect[E](right),
        _FeartReduceFn[mut List[E], mut List[E]]{l, r -> _FeartDriver.collectReducer[E]#(l, r)}
        ),
      },
    .empty -> this.runChunkCollect[E](flow),
    }),

  mut .driveFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> _FeartDriver.splitMatch[E, mut Opt[R]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[R], mut Opt[R]](
        this.driveFindMap[E,R](left, f),
        this.driveFindMap[E,R](right, f),
        _FeartReduceFn[mut Opt[R], mut Opt[R]]{l, r -> _FeartDriver.findMapReducer[R]#(l, r)}
        ),
      },
    .empty -> this.runChunkFindMap[E,R](flow, f),
    }),

  mut .driveFor[E:*](flow: mut Flow[E], f: read F[E, Void]): Void -> _FeartDriver.splitMatch[E, Void](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[Void](
        this.driveFor[E](left, f),
        this.driveFor[E](right, f)
        ),
      },
    .empty -> this.runChunkFor[E](flow, f),
    }),

  mut .driveFirst[E:*](flow: mut Flow[E]): mut Opt[E] -> _FeartDriver.splitMatch[E, mut Opt[E]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[E]](
        this.driveFirst[E](left),
        this.driveFirst[E](right)
        ),
      },
    .empty -> this.runChunkFirst[E](flow),
    }),

  /// Order-insensitive findMap. Same shape as `driveFindMap` but the leaf
  /// (`runChunkUnorderedFindMap`) calls `scope.request()` on first match,
  /// cancelling sibling forks. Routed via `.merge/3` with `findMapReducer`
  /// (left-biased first-some-wins), the same VPF re-tag slot as the other
  /// parallelisable drives.
  mut .driveUnorderedFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> _FeartDriver.splitMatch[E, mut Opt[R]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[R], mut Opt[R]](
        this.driveUnorderedFindMap[E,R](left, f),
        this.driveUnorderedFindMap[E,R](right, f),
        _FeartReduceFn[mut Opt[R], mut Opt[R]]{l, r -> _FeartDriver.findMapReducer[R]#(l, r)}
        ),
      },
    .empty -> this.runChunkUnorderedFindMap[E,R](flow, f),
    }),

  /// Parallel max-by-comparator. The transient merger captures `compare` and
  /// reduces two Opt[E] halves to a single Opt[E].
  mut .driveMax[E:*](flow: mut Flow[E], compare: read F[E, E, Ordering]): mut Opt[E] -> _FeartDriver.splitMatch[E, mut Opt[E]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[E], mut Opt[E]](
        this.driveMax[E](left, compare),
        this.driveMax[E](right, compare),
        read _FeartReduceFn[mut Opt[E], mut Opt[E]]{l, r -> l.match{
          .empty -> r,
          .some(a) -> r.match{
            .empty -> l,
            .some(b) -> compare#(a, b).match{
              .less -> r,
              .equal -> l,
              .greater -> l,
              },
            },
          }}
        ),
      },
    .empty -> this.runChunkMax[E](flow, compare),
    }),
  .splitMatch[E:*, R:*](flow: mut Flow[E], cases: mut _FeartSplitMatch[E, R]): R -> Magic!,
  mut .runChunkReduce[E:*,A:*](flow: mut Flow[E], initial: A, combine: read _FeartReduceFn[A,E]): A -> Magic!,
  mut .runChunkCollect[E:*](flow: mut Flow[E]): mut List[E] -> Magic!,
  mut .runChunkFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> Magic!,
  mut .runChunkFor[E:*](flow: mut Flow[E], f: read F[E, Void]): Void -> Magic!,
  mut .runChunkFirst[E:*](flow: mut Flow[E]): mut Opt[E] -> Magic!,
  /// Sequential leaf for `driveUnorderedFindMap`. Same shape as
  /// `runChunkFindMap` but the Zig accept-fn calls `scope.request()` on first
  /// match, so any sibling subtree currently running on a thief observes the
  /// cancel at its next chunk poll and returns early.
  mut .runChunkUnorderedFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> Magic!,
  /// Sequential max leaf. Body delegates to `runChunkReduce` with an Opt-based
  /// fold accumulator; it keeps Ordering-matching in Fearless and avoids a
  /// dedicated Zig sequential driver. `runChunkReduce` takes `initial: A`
  /// directly (the iso-MF unwrapping happens in `flow_fold`'s Zig dispatch),
  /// so the seed is `{}` not `{{}}`.
  mut .runChunkMax[E:*](flow: mut Flow[E], compare: read F[E, E, Ordering]): mut Opt[E] ->
    this.runChunkReduce[E, mut Opt[E]](flow, {}, read _FeartReduceFn[mut Opt[E], E]{max, b -> max.match{
      .empty -> Opts#b,
      .some(a) -> compare#(a, b).match{
        .less -> Opts#b,
        .equal -> max,
        .greater -> max,
        },
      }}),

  /// Cancellation poll. Zig body loads TLS `active_scope` and walks its
  /// parent chain for the cancel bit (see `scope.zig::currentCancelled`).
  /// Each `drive*`'s `.some(pair)` branch polls this before recursing so a
  /// cancellation short-circuits the subtree without doing the split's work.
  /// Cancel triggers are wired through `_TerminalOps`'s short-circuiting
  /// terminals (`.any`, `.all`, `.none`) via `.unorderedFindMap`, whose
  /// accept fn calls `scope.request()` on the first match.
  mut .shouldStop: Bool -> Magic!,

  /// Identity-on-left stub used by `.driveFor` (effects fire on both halves
  /// regardless; merge result is meaningless Void) and `.driveFirst` (split
  /// preserves order, left half always non-empty, so left-first = semantic-
  /// first). The other two non-reduce drives now route through `.merge/3` with
  /// a structural reducer (see `.collectReducer` / `.findMapReducer` below).
  .merge[A:*](left: A, right: A): A -> left,

  /// Singleton reducer for `.driveCollect`. Runtime body lives in
  /// `driver.zig::VT_ListConcatReducer`'s `read #/2` handler: appends the
  /// right list's items into the left list and returns left.
  .collectReducer[E:*]: read F[mut List[E], mut List[E], mut List[E]] -> Magic!,

  /// Singleton reducer for `.driveFindMap`. Runtime body lives in
  /// `driver.zig::VT_FirstSomeReducer`'s `read #/2` handler: returns left if
  /// left.isSome, else right (first-some-wins, left-biased).
  .findMapReducer[R:*]: read F[mut Opt[R], mut Opt[R], mut Opt[R]] -> Magic!,

  /// Real VPF combiner for .driveReduce. The MIR re-tag pass marks this MCall
  /// site as VPFParallelisable; VPFCodegen wraps the two recursive
  /// .driveReduce args in thief/shadow-frame infrastructure and re-emits this
  /// call as the combiner. Body is `Magic!` because Fearless's F[A,E,A] apply
  /// method only accepts (A,E) args, but we need to pass (A,A). The Zig
  /// vtable does the FatPtr-level dispatch, correct whenever A=E at runtime
  /// (sum-like left-folds). Mixed-type accumulators (A≠E) are not supported.
  .merge[E:*,A:*](left: A, right: A, combine: read _FeartReduceFn[A,E]): A -> Magic!,
  }

_FeartReduceFn[A:*, E:*]: Transient, F[A,E,A]{}

_FeartSplitMatch[E:*, R:*]: Transient{
  mut .some(left: mut Flow[E], right: mut Flow[E]): R,
  mut .empty: R,
  }
