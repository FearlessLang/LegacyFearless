package base.flows

/// This private & sealed type is for interoperability with the FeaRT runtime for Fearless.
/// With FeaRT, flows are implemented magically in the Fearless runtime for performance reasons and
/// to enable automatic parallelisation, which we drive through VPF rather than the custom strategies
/// the Java backend uses. The `.drive*` methods parallelise by having their recursive halves be the
/// args of a `.merge/3` or `.mergeFold/3` call, which `MIRInjectionVisitor` hardcodes as
/// VPFParallelisable: the calls can introduce user observable effects, and their args are `mut`
/// methods reached through `this`, which `ComputeVPFMode`'s mut-weakening rules reject on their own.
///
/// The FeaRT code that implements this type is in `runtime/flows/driver.zig` and delegates to the generated
/// Fearless code written here except for the magic methods.
/// Magic methods that depend on runtime state are still marked as `mut` to abide by the Fearless type system's rules.
_FeartDriver: Sealed{
  /// The public `.fold` terminal. `F[A,E,A]` is an arbitrary left-fold step: not associative,
  /// `initial` is not an identity, and `A` need not be `E`. So two accumulators can never be
  /// combined and `combine` must see every element on one thread, in order.
  mut .driveReduce[E:*,A:*](flow: mut Flow[E], initial: A, combine: read F[A,E,A]): A ->
    this.driveReduceFn[E,A](flow, initial, read _FeartReduceFn[A,E]{a, e -> combine#(a, e)}),

  /// Parallelism above, ordering at the terminal. At each split the left half is folded
  /// recursively while the right half is collected into its own list; `.mergeFold` then folds that
  /// chunk starting from the left's accumulator, so every element reaches `combine` once, in order,
  /// on one thread. Each chunk dies at its merge point, so nothing larger than a chunk is live at a
  /// time and the `.empty` leaf materialises no list at all.
  mut .driveReduceFn[E:*,A:*](flow: mut Flow[E], initial: A, combine: read _FeartReduceFn[A,E]): A -> _FeartDriver.splitMatch[E,A](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> initial,
      .else -> _FeartDriver.mergeFold[E,A](
        this.driveReduceFn[E,A](left, initial, combine),
        this.driveCollect[E](right),
        combine
        ),
      },
    .empty -> this.runChunkReduce[E,A](flow, initial, combine),
    }),

  /// Unlike `.driveReduce`, the reducer here is list concatenation rather than an arbitrary
  /// user-defined function, so it is associative and the two halves can merge via `.merge/3`.
  mut .driveCollect[E:*](flow: mut Flow[E]): mut List[E] -> _FeartDriver.splitMatch[E, mut List[E]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> List#[E],
      .else -> _FeartDriver.merge[mut List[E], mut List[E]](
        this.driveCollect[E](left),
        this.driveCollect[E](right),
        _FeartReduceFn[mut List[E], mut List[E]]{l, r -> _FeartDriver.collectReducer[E]#(l, r)}
        ),
      },
    .empty -> this.runChunkCollect[E](flow),
    }),

  mut .driveFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> _FeartDriver.splitMatch[E, mut Opt[R]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[R], mut Opt[R]](
        this.driveFindMap[E,R](left, f),
        this.driveFindMap[E,R](right, f),
        _FeartReduceFn[mut Opt[R], mut Opt[R]]{l, r -> _FeartDriver.findMapReducer[R]#(l, r)}
        ),
      },
    .empty -> this.runChunkFindMap[E,R](flow, f),
    }),

  mut .driveFor[E:*](flow: mut Flow[E], f: read F[E, Void]): Void -> _FeartDriver.splitMatch[E, Void](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[Void](
        this.driveFor[E](left, f),
        this.driveFor[E](right, f)
        ),
      },
    .empty -> this.runChunkFor[E](flow, f),
    }),

  mut .driveFirst[E:*](flow: mut Flow[E]): mut Opt[E] -> _FeartDriver.splitMatch[E, mut Opt[E]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[E]](
        this.driveFirst[E](left),
        this.driveFirst[E](right)
        ),
      },
    .empty -> this.runChunkFirst[E](flow),
    }),

  /// Order-insensitive findMap. Same shape as `.driveFindMap`, but the leaf
  /// (`.runChunkUnorderedFindMap`) calls `scope.request()` on first match, cancelling sibling forks.
  mut .driveUnorderedFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> _FeartDriver.splitMatch[E, mut Opt[R]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[R], mut Opt[R]](
        this.driveUnorderedFindMap[E,R](left, f),
        this.driveUnorderedFindMap[E,R](right, f),
        _FeartReduceFn[mut Opt[R], mut Opt[R]]{l, r -> _FeartDriver.findMapReducer[R]#(l, r)}
        ),
      },
    .empty -> this.runChunkUnorderedFindMap[E,R](flow, f),
    }),

  mut .driveMax[E:*](flow: mut Flow[E], compare: read F[E, E, Ordering]): mut Opt[E] -> _FeartDriver.splitMatch[E, mut Opt[E]](flow, {
    .some(left, right) -> this.shouldStop ? {
      .then -> {},
      .else -> _FeartDriver.merge[mut Opt[E], mut Opt[E]](
        this.driveMax[E](left, compare),
        this.driveMax[E](right, compare),
        read _FeartReduceFn[mut Opt[E], mut Opt[E]]{l, r -> l.match{
          .empty -> r,
          .some(a) -> r.match{
            .empty -> l,
            .some(b) -> compare#(a, b).match{
              .less -> r,
              .equal -> l,
              .greater -> l,
              },
            },
          }}
        ),
      },
    .empty -> this.runChunkMax[E](flow, compare),
    }),
  .splitMatch[E:*, R:*](flow: mut Flow[E], cases: mut _FeartSplitMatch[E, R]): R -> Magic!,
  mut .runChunkReduce[E:*,A:*](flow: mut Flow[E], initial: A, combine: read _FeartReduceFn[A,E]): A -> Magic!,
  mut .runChunkCollect[E:*](flow: mut Flow[E]): mut List[E] -> Magic!,
  mut .runChunkFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> Magic!,
  mut .runChunkFor[E:*](flow: mut Flow[E], f: read F[E, Void]): Void -> Magic!,
  mut .runChunkFirst[E:*](flow: mut Flow[E]): mut Opt[E] -> Magic!,
  /// The Zig accept-fn calls `scope.request()` on first match, so a sibling subtree running on a
  /// thief observes the cancel at its next chunk poll and returns early.
  mut .runChunkUnorderedFindMap[E:*,R:*](flow: mut Flow[E], f: read F[E, mut Opt[R]]): mut Opt[R] -> Magic!,
  /// `.runChunkReduce` takes `initial: A` directly (the iso-MF unwrapping happens in `flow_fold`'s
  /// Zig dispatch), so the seed is `{}` and not `{{}}`.
  mut .runChunkMax[E:*](flow: mut Flow[E], compare: read F[E, E, Ordering]): mut Opt[E] ->
    this.runChunkReduce[E, mut Opt[E]](flow, {}, read _FeartReduceFn[mut Opt[E], E]{max, b -> max.match{
      .empty -> Opts#b,
      .some(a) -> compare#(a, b).match{
        .less -> Opts#b,
        .equal -> max,
        .greater -> max,
        },
      }}),

  /// Cancellation poll: the Zig body loads TLS `active_scope` and walks its parent chain for the
  /// cancel bit (see `scope.zig::currentCancelled`). Every `.drive*` polls it in the `.some` branch
  /// so a cancellation short-circuits the subtree without doing the split's work.
  mut .shouldStop: Bool -> Magic!,

  /// Identity-on-left stub for the drives that need no real merge: `.driveFor`, whose effects fire
  /// on both halves regardless and whose Void result is meaningless, and `.driveFirst`, where the
  /// split preserves order and the left half is always non-empty, so left-first is semantic-first.
  .merge[A:*](left: A, right: A): A -> left,

  /// Singleton reducer for `.driveCollect`. Runtime body is `driver.zig::VT_ListConcatReducer`'s
  /// `read #/2` handler: appends the right list's items into the left list and returns left.
  .collectReducer[E:*]: read F[mut List[E], mut List[E], mut List[E]] -> Magic!,

  /// Singleton reducer for `.driveFindMap`. Runtime body is `driver.zig::VT_FirstSomeReducer`'s
  /// `read #/2` handler: returns left if left.isSome, else right (left-biased first-some-wins).
  .findMapReducer[R:*]: read F[mut Opt[R], mut Opt[R], mut Opt[R]] -> Magic!,

  /// VPF combiner for the drives whose reducer is associative. VPFCodegen wraps the two recursive
  /// drive args in thief/shadow-frame infrastructure and re-emits this call as the combiner. Body is
  /// `Magic!` because Fearless's `F[A,E,A]` apply method only accepts (A,E) args but we pass (A,A);
  /// the Zig vtable's FatPtr-level dispatch requires A=E at runtime, which holds because every
  /// caller passes a dedicated `_FeartReduceFn[R,R]`. Mixed-type accumulators are why `.fold` uses
  /// `.mergeFold` instead.
  .merge[E:*,A:*](left: A, right: A, combine: read _FeartReduceFn[A,E]): A -> Magic!,

  /// VPF combiner for `.driveReduceFn`. Its two parallelisable args are an accumulator and a chunk
  /// of elements rather than two accumulators, which is what lets a non-associative `F[A,E,A]` be
  /// driven in parallel at all; the differing types are also why `.merge/3` cannot express it. The
  /// Zig vtable applies `combine` to each of the chunk's elements in index order, from `acc`.
  .mergeFold[E:*,A:*](acc: A, chunk: mut List[E], combine: read _FeartReduceFn[A,E]): A -> Magic!,
  }

_FeartReduceFn[A:*, E:*]: F[A,E,A]{}

_FeartSplitMatch[E:*, R:*]: {
  mut .some(left: mut Flow[E], right: mut Flow[E]): R,
  mut .empty: R,
  }
