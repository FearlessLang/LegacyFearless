package bench

Boards: { #(cols: Nat, d1: Nat, d2: Nat): Board -> {.cols -> cols, .d1 -> d1, .d2 -> d2} }

/// The search state, as three `Nat` bitmasks: the used columns, and the two diagonal groups.
/// All fields are `imm`, so the search holds no mutable data.
Board: {
  .cols: Nat,
  .d1: Nat,
  .d2: Nat,
  /// The board with a queen at `row` and column `c`. It is empty when another queen attacks
  /// that square. The diagonal indexes are `row + c` and `row + n - c`, and both stay below 2n.
  .place(row: Nat, c: Nat, n: Nat): mut Opt[Board] -> this.attacked(row, c, n).if[mut Opt[Board]]{
    .then -> {},
    .else -> Opts#(Boards#(
      this.cols.bitwiseOr(1.shiftLeft(c)),
      this.d1.bitwiseOr(1.shiftLeft(row + c)),
      this.d2.bitwiseOr(1.shiftLeft((row + n) - c)))),
    },
  .attacked(row: Nat, c: Nat, n: Nat): Bool ->
    (this.cols.bitwiseAnd(1.shiftLeft(c)) != 0)
      .or(this.d1.bitwiseAnd(1.shiftLeft(row + c)) != 0)
      .or(this.d2.bitwiseAnd(1.shiftLeft((row + n) - c)) != 0),
  }

/// Counts the n-queens solutions. The branches stop at very different depths, so this benchmark
/// tests the promotion policy and not the throughput.
NQueens: {
  .n: Nat -> 14,
  .solve(b: Board, row: Nat): Nat -> (row >= (this.n)).if[Nat]{
    .then -> 1,
    .else -> this.tryCols(b, row, 0, this.n),
    },
  .mid(lo: Nat, hi: Nat): Nat -> lo + ((hi - lo) / 2),
  .leaf(b: Board, row: Nat, c: Nat): Nat -> b.place(row, c, this.n).match[Nat]{
    .some(next) -> this.solve(next, row + 1),
    .empty -> 0,
    },
  /// A binary split of the candidate columns `[lo, hi)`. The usual recursion is n-ary, which does
  /// not obey the two-MCall rule.
  .tryCols(b: Board, row: Nat, lo: Nat, hi: Nat): Nat -> (lo >= hi).if[Nat]{
    .then -> 0,
    .else -> ((hi - lo) <= 1).if[Nat]{
      .then -> this.leaf(b, row, lo),
      .else -> this.tryCols(b, row, lo, this.mid(lo, hi))
        + (this.tryCols(b, row, this.mid(lo, hi), hi)),
      },
    },
  }

Test: Main {sys -> sys.io.println(NQueens.solve(Boards#(0, 0, 0), 0).str)}
