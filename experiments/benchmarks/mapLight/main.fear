package bench

/// Divide and conquer over `[0, n)`, trivial work per element. The leaf is one
/// element, so `feart / feart-novpf` here is almost purely the cost of the
/// parallelism machinery. The adversarial case.
MapLight: {
  .n: Nat -> 1400000000,

  .leaf(i: Nat): Nat -> (i * 2) + 1,

  /// Recomputed at both use sites rather than bound: binding it would make the
  /// halves of `.solve` bindings instead of MCalls, and silently disable
  /// parallelism. Two integer ops against keeping the VPF shape.
  .mid(lo: Nat, hi: Nat): Nat -> lo + ((hi - lo) / 2),

  /// Receiver and argument of the combining `+` are both MCalls over `imm`
  /// data: that is what makes the call VPF-eligible.
  .solve(lo: Nat, hi: Nat): Nat -> ((hi - lo) <= 1).if[Nat]{
    .then -> this.leaf(lo),
    .else -> this.solve(lo, this.mid(lo, hi)) + (this.solve(this.mid(lo, hi), hi)),
    },
  }

Test: Main {sys -> sys.io.println(MapLight.solve(0, MapLight.n).str)}
