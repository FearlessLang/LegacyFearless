package bench

Complexes: { #(re: Float, im: Float): Complex -> {.re -> re, .im -> im}, }

/// A complex number as an object rather than a pair of loose `Float`s. Also a
/// direct test of FeaRT's stack allocation of transient object literals: one
/// of these is built per escape iteration and none of them escape.
Complex: {
  .re: Float,
  .im: Float,
  .add(c: Complex): Complex -> Complexes#(this.re + (c.re), this.im + (c.im)),
  .sq: Complex -> Complexes#(
    (this.re * (this.re)) - (this.im * (this.im)),
    2.0 * (this.re) * (this.im)),
  .norm2: Float -> (this.re * (this.re)) + (this.im * (this.im)),
  }

/// Escape-time Mandelbrot, summing every pixel's iteration count. Pixel cost
/// ranges from one iteration to `maxIter`, so no static granularity is right
/// for the whole grid. The split runs over the flat index range `[0, w*h)`
/// rather than over rows, so the leaf is one pixel.
Mandelbrot: {
  .w: Nat -> 2048,
  .h: Nat -> 2048,
  .maxIter: Nat -> 256,

  /// Iterations until `|z|^2` exceeds 4, capped at `maxIter`. The cap is
  /// tested before the escape condition, which is what fixes the checksum.
  .escape(c: Complex, z: Complex, i: Nat): Nat -> (i >= (this.maxIter)).if[Nat]{
    .then -> this.maxIter,
    .else -> (z.norm2 > 4.0).if[Nat]{
      .then -> i,
      .else -> this.escape(c, z.sq.add(c), i + 1),
      },
    },

  /// Window: real `[-2.5, 1.0)`, imaginary `[-1.0, 1.0)`. Written as
  /// subtractions because there is no unary minus.
  .point(idx: Nat): Complex -> Complexes#(
    (((idx % (this.w)).float * 3.5) / (this.w.float)) - 2.5,
    (((idx / (this.w)).float * 2.0) / (this.h.float)) - 1.0),

  .leaf(idx: Nat): Nat -> this.escape(this.point(idx), Complexes#(0.0, 0.0), 0),

  .mid(lo: Nat, hi: Nat): Nat -> lo + ((hi - lo) / 2),

  /// Two MCalls over `imm` data: VPF-eligible. See `mapLight`.
  .solve(lo: Nat, hi: Nat): Nat -> ((hi - lo) <= 1).if[Nat]{
    .then -> this.leaf(lo),
    .else -> this.solve(lo, this.mid(lo, hi)) + (this.solve(this.mid(lo, hi), hi)),
    },
  }

Test: Main {sys -> sys.io.println(Mandelbrot.solve(0, Mandelbrot.w * (Mandelbrot.h)).str)}
