package bench

/// Running word-count state. All `imm`, so the fold carries nothing mutable.
WcState: {
  .bytes: Nat,
  .lines: Nat,
  .words: Nat,
  .inWord: Bool,
  }

WcStates: {
  #(b: Nat, l: Nat, w: Nat, iw: Bool): WcState -> {
    .bytes -> b,
    .lines -> l,
    .words -> w,
    .inWord -> iw,
    },

  .zero: WcState -> WcStates#(0, 0, 0, False),

  /// One codepoint of the word-count monoid. A word is counted where it
  /// starts, the only transition needing the previous codepoint. The corpus is
  /// ASCII, so a codepoint is a byte and the separators are space and newline.
  /// Named rather than inline at the fold: three-parameter lambdas in argument
  /// position do not always infer.
  .step: read F[WcState, Str, WcState] -> {s, c -> Block#
    .if {c == "\n"} .return {WcStates#(s.bytes + 1, s.lines + 1, s.words, False)}
    .if {c == " "} .return {WcStates#(s.bytes + 1, s.lines, s.words, False)}
    .if {s.inWord} .return {WcStates#(s.bytes + 1, s.lines, s.words, True)}
    .return {WcStates#(s.bytes + 1, s.lines, s.words + 1, True)}
    },
  }

/// Reading the file is inside the timed process on purpose: wall clock is the
/// headline number and I/O is part of what the program costs.
Test: Main {sys -> Block#
  .let[Str] text = {sys.io.accessR(List#[Str]("corpus", "corpus.txt")).readStr!}
  .let[WcState] res = {text.codepoints.fold[WcState]({WcStates.zero}, WcStates.step)}
  .let[Str] bytes = {res.bytes.str}
  .let[Str] lines = {res.lines.str}
  .let[Str] words = {res.words.str}
  .return {sys.io.println(bytes + " " + lines + " " + words)}
  }
